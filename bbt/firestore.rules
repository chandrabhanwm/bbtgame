rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── saves/{uid} ────────────────────────────────────────────────
    // Full game save (businesses, stats, progress). Strictly private —
    // only the player who owns this UID can ever read or write it.
    match /saves/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── sessions/{uid} ─────────────────────────────────────────────
    // Single-active-device session claim. Only the account owner ever
    // needs to read or write their own slot.
    match /sessions/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── leaderboard/{uid} ──────────────────────────────────────────
    // Public leaderboard: every signed-in player can read (needed for
    // top-N and rank queries), but a player can only ever write their
    // own entry, and only with a valid, well-typed shape — this is what
    // stops a modified client from writing fake data into someone
    // else's entry or inflating fields with the wrong type.
    match /leaderboard/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isValidLeaderboardEntry();

      function isValidLeaderboardEntry() {
        let d = request.resource.data;
        return d.keys().hasAll([
              'playerName', 'avatarEmoji', 'netWorth', 'level', 'updatedAt',
              'weeklyPoints', 'currentDistrictId', 'totalPlayTimeSeconds',
              'adsWatchedCount', 'businessesBoughtCount', 'poolClaimsCount'
            ])
          && d.playerName is string && d.playerName.size() <= 40
          && d.avatarEmoji is string && d.avatarEmoji.size() <= 8
          && d.netWorth is number && d.netWorth >= 0
          && d.level is number && d.level >= 0
          && d.weeklyPoints is number && d.weeklyPoints >= 0
          && d.updatedAt is number
          && d.currentDistrictId is string
          && d.totalPlayTimeSeconds is number && d.totalPlayTimeSeconds >= 0
          && d.adsWatchedCount is number && d.adsWatchedCount >= 0
          && d.businessesBoughtCount is number && d.businessesBoughtCount >= 0
          && d.poolClaimsCount is number && d.poolClaimsCount >= 0;
      }
    }

    // ── referrals/{newUserUid} ─────────────────────────────────────
    // Doc ID is always the NEW user's own UID.
    //  - create: only the new user themself can create their own record.
    //  - read: any signed-in player (matches this app's fetchUnclaimedReferrals
    //    query, which filters by referrerUid == caller's own uid).
    //  - update: only the referrer can update it, and only the `claimed` field.
    //  - delete: never, from the client.
    match /referrals/{newUserUid} {
      allow create: if request.auth != null && request.auth.uid == newUserUid;
      allow read: if request.auth != null;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.referrerUid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']);
      allow delete: if false;
    }

    // Deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
